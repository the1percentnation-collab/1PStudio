# Copy to .env and fill in your values for local emulator use
# For production, use: firebase functions:secrets:set ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Social publishing via Zernio (https://zernio.com). Required for the Accounts,
# Composer publish, and Posts history features.
#   firebase functions:secrets:set ZERNIO_API_KEY
ZERNIO_API_KEY=your-zernio-api-key-here
# Optional: pin a specific Zernio profile. If unset, the first profile on the
# API key is used (fine for a single-profile account).
# ZERNIO_PROFILE_ID=
