# Copy this file to .env.local and fill in your key.
# NEVER commit .env.local to git.
#
# Get your key at: https://console.anthropic.com/
REACT_APP_ANTHROPIC_API_KEY=sk-ant-your-key-here

# Social publishing (Ayrshare) — used by the publishPost Cloud Function.
# This belongs in functions/.env on the server, NOT in the browser bundle.
# Get your key at: https://app.ayrshare.com/  ->  API Key
# AYRSHARE_API_KEY=your-ayrshare-api-key

# Auto-captions transcription (Deepgram) — used by the captionVideo function.
# Server-side only (functions/.env or a GitHub secret named DEEPGRAM_API_KEY).
# Get your key at: https://console.deepgram.com/
# DEEPGRAM_API_KEY=your-deepgram-api-key

# Firebase web config (optional) — for direct browser->Storage video uploads.
# These are public client values; the app ships with working defaults, so set
# these only if you point 1P Studio at a different Firebase project.
# REACT_APP_FIREBASE_API_KEY=
# REACT_APP_FIREBASE_AUTH_DOMAIN=
# REACT_APP_FIREBASE_PROJECT_ID=
# REACT_APP_FIREBASE_STORAGE_BUCKET=
# REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
# REACT_APP_FIREBASE_APP_ID=
