# Copy this file to .env.local and fill in your key.
# NEVER commit .env.local to git.
#
# Get your key at: https://console.anthropic.com/
REACT_APP_ANTHROPIC_API_KEY=sk-ant-your-key-here

# Social publishing (Ayrshare) — used by the publishPost Cloud Function.
# This belongs in functions/.env on the server, NOT in the browser bundle.
# Get your key at: https://app.ayrshare.com/  ->  API Key
# AYRSHARE_API_KEY=your-ayrshare-api-key
