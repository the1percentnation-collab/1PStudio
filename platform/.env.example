# ---- AI vendors (optional — every service falls back to deterministic mocks) ----
ANTHROPIC_API_KEY=
# Claude model for clip selection (default claude-haiku-4-5 — the cheap tier)
ANTHROPIC_MODEL=claude-haiku-4-5
# auto | whisper | mock
ASR_BACKEND=auto

# ---- Data plane ----
DATABASE_URL=postgresql://onepct:onepct@localhost:5432/onepct
REDIS_URL=redis://localhost:6379

# ---- Temporal ----
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=video-pipeline

# ---- Object storage (MinIO in dev) ----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=onepct
S3_SECRET_KEY=onepct-secret
S3_REGION=us-east-1
S3_BUCKET_SOURCES=sources
S3_BUCKET_ARTIFACTS=artifacts
S3_BUCKET_RENDERS=renders

# ---- Service URLs (docker-compose network names in containers) ----
ML_URL=http://localhost:8000
RENDER_URL=http://localhost:8080
API_URL=http://localhost:3001

# ---- API ----
API_PORT=3001
JWT_SECRET=dev-jwt-secret-change-me
