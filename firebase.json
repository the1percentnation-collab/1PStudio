{
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/analyze",
        "function": "analyzeVideo",
        "region": "us-central1"
      },
      {
        "source": "/api/publish",
        "function": "publishPost",
        "region": "us-central1"
      },
      {
        "source": "/api/accounts",
        "function": "accountsStatus",
        "region": "us-central1"
      },
      {
        "source": "/api/caption",
        "function": "captionVideo",
        "region": "us-central1"
      },
      {
        "source": "/api/transcribe",
        "function": "transcribeAudio",
        "region": "us-central1"
      },
      {
        "source": "/api/history",
        "function": "postHistory",
        "region": "us-central1"
      },
      {
        "source": "/api/clips",
        "function": "selectClips",
        "region": "us-central1"
      },
      {
        "source": "/api/render",
        "function": "renderOverlays",
        "region": "us-central1"
      },
      {
        "source": "/api/client-error",
        "function": "reportClientError",
        "region": "us-central1"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
