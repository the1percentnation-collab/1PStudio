{
  "functions": {
    "source": "functions",
        "runtime": "nodejs20"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/analyze",
        "function": "analyzeVideo",
        "region": "us-central1"
      },
      {
        "source": "/api/publish",
        "function": "publishPost",
        "region": "us-central1"
      },
      {
        "source": "/api/accounts",
        "function": "accountsStatus",
        "region": "us-central1"
      },
      {
        "source": "/api/caption",
        "function": "captionVideo",
        "region": "us-central1"
      },
      {
        "source": "/api/transcribe",
        "function": "transcribeAudio",
        "region": "us-central1"
      },
      {
        "source": "/api/generate",
        "function": "generateVideo",
        "region": "us-central1"
      },
      {
        "source": "/api/video-status",
        "function": "videoStatus",
        "region": "us-central1"
      },
      {
        "source": "/api/import",
        "function": "importVideo",
        "region": "us-central1"
      },
      {
        "source": "/api/cover-image",
        "function": "generateCoverImage",
        "region": "us-central1"
      },
      {
        "source": "/api/cover-image-status",
        "function": "coverImageStatus",
        "region": "us-central1"
      },
      {
        "source": "/api/cover-image-free",
        "function": "coverImageFree",
        "region": "us-central1"
      },
      {
        "source": "/api/media",
        "function": "mediaProxy",
        "region": "us-central1"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
